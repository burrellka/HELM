# Copy to .env next to the compose file, then edit. NEVER commit the real .env
# (.gitignore already excludes it).
#
#   cp .env.example .env   &&   edit
#
# Your container manager (Dockge, Portainer, plain `docker compose`) reads the
# .env sitting beside the compose file automatically.

# ── Lemonade admin key ──────────────────────────────────────────────────────
# Gates the management routes (load / unload / pin / delete / config). Find it
# in your Lemonade server's configuration (wherever you set its API key).
#
# Leave EMPTY to run HELM read-only. That is a supported mode, not a broken
# one: the dashboard works, and the UI hides the write controls and says why.
HELM_LEMONADE_ADMIN_API_KEY=

# ── Lemonade global key (optional) ──────────────────────────────────────────
# Only if you have set a global LEMONADE_API_KEY on the server. It gates ALL
# routes including reads, and setting it also disables Lemonade's own bundled
# UI. Most people leave this blank.
HELM_LEMONADE_API_KEY=

# ── HELM's own JWT secret ───────────────────────────────────────────────────
# Leave EMPTY. HELM generates one at /data/jwt_secret on first boot and reuses
# it across restarts. Set it only if you want to manage rotation yourself; a
# value here overrides the file.
HELM_JWT_SECRET=

# ── Upstream URL ────────────────────────────────────────────────────────────
# Where your Lemonade Server listens. If Lemonade runs as a host service (not a
# container), use the host's LAN IP rather than a container name. Examples:
#   http://localhost:13305          (Lemonade on the same machine as HELM)
#   http://192.168.1.50:13305       (Lemonade on another box on your LAN)
HELM_LEMONADE_URL=http://YOUR_LEMONADE_HOST:13305

# ── Model Advisor web search (optional) ─────────────────────────────────────
# A Google Gemini API key used ONLY for the advisor's grounded web lookups —
# separate from any model key. The free tier is generous. Get one at
# https://aistudio.google.com. Leave EMPTY and the advisor runs without live
# lookups and says so honestly.
HELM_WEB_SEARCH_KEY=

# ── Who helm-api runs as ────────────────────────────────────────────────────
# Must match the owner (uid:gid) of the host directory you bind-mount to /data,
# or SQLite cannot write and the app refuses to boot. Check it on your host:
#   id <your-user>
#   stat -c '%u %g %a' /path/to/your/helm/data
#
# These feed compose's `user:` directive. They are NOT the LinuxServer.io
# PUID/PGID convention: this image has no init layer that reads them as env
# vars, so passing them as env alone would silently do nothing and leave the
# container running as root. Default 1000:1000 is the typical first Linux user.
#
# Applies to helm-api only. helm-web (nginx) stays root — it needs it for its
# master process and writes nothing to your disk.
PUID=1000
PGID=1000

# Container log timestamps only. HELM stores UTC and the UI renders in the
# browser's timezone; this does not affect any stored data.
TZ=UTC
